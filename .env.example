APP_ENV=production

POSTGRES_DB=logs_dashboard
POSTGRES_USER=logs
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

ALLOWED_ORIGINS=https://logs.example.com

# Mail log ingestion
MAILLOG_PATH=/var/log/maillog
AUTO_INGEST=true
MAILLOG_POLL_INTERVAL=250ms
MAILLOG_ROTATION_DRAIN_TIMEOUT=1s
MAILLOG_QUEUE_IDLE_TIMEOUT=30m
MAILLOG_PROCESSING_WORKERS=4

# Nginx brute-force detection
AUTO_NGINX_SECURITY_INGEST=true
NGINX_LOG_DIR=/var/log/nginx
NGINX_ACCESS_LOG_PATH=/var/log/nginx/access.log
NGINX_LOG_POLL_INTERVAL=250ms
NGINX_LOG_ROTATION_DRAIN_TIMEOUT=1s
BRUTEFORCE_404_CONSECUTIVE_THRESHOLD=10
BRUTEFORCE_404_WINDOW=2m
BRUTEFORCE_404_IGNORED_PATHS=/favicon.ico,/robots.txt,/api/health
BRUTEFORCE_AUTH_THRESHOLD=10
BRUTEFORCE_AUTH_WINDOW=5m
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
SECURITY_IP_ALLOWLIST=127.0.0.0/8,::1/128

# Host access group used for the firewall socket and optional log group access.
FIREWALL_AGENT_SOCKET=/run/logs-dashboard/firewall.sock
HOST_ACCESS_GID=65532

# PostgreSQL connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

FRONTEND_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
